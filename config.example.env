# Папка проектов. Если оставить пустым, бот попробует найти YandexDisk/Курсовые у текущего Windows-пользователя.
PROJECTS_ROOT=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
MAX_UPLOAD_MB=20

# OpenAI: document intelligence, vision, final quality review.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=

# DeepSeek: основной writer/reasoning.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Pipeline
MAX_CONTEXT_CHARS=120000
MAX_OUTPUT_TOKENS=12000
TOP_CHUNKS=30
CHUNK_CHARS=4500
CHUNK_OVERLAP=500
MAX_REVIEW_LOOPS=2
REVIEW_SCORE_THRESHOLD=85
USE_QUALITY_REVIEW=1
USE_NATURAL_EDITOR=1
ENABLE_VISION=1
MAX_VISION_PAGES=12

# AcademicPreset — fallback, если методичка не содержит конкретного требования.
DEFAULT_FONT_NAME=Times New Roman
DEFAULT_FONT_SIZE_PT=14
DEFAULT_LINE_SPACING=1.5
DEFAULT_FIRST_LINE_INDENT_CM=1.25
DEFAULT_MARGIN_LEFT_CM=3
DEFAULT_MARGIN_RIGHT_CM=1.5
DEFAULT_MARGIN_TOP_CM=2
DEFAULT_MARGIN_BOTTOM_CM=2

# --- Владелец и пуш-уведомления ---
# Числовые Telegram user_id владельцев через запятую: пуши о job'ах, ошибках, оплатах, новых пользователях.
ADMIN_IDS=
# Ссылка для кнопки «написать владельцу» (если пусто — tg://user?id=<первый ADMIN_IDS>).
OWNER_LINK=

# --- Mini App ---
# Публичный HTTPS-адрес приложения (BotFather → Menu Button / Web App кнопка).
# Сервер поднимается сам при старте бота на MINIAPP_HOST:MINIAPP_PORT.
MINIAPP_URL=
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080
# Только для локальной разработки: разрешает вход по заголовку X-Dev-User.
DEV_MODE=0

# --- Биллинг ---
# Сколько работ можно создать бесплатно, до показа окна оплаты.
FREE_PROJECTS=2

# --- Обслуживание ---
# Сколько версий каждого раздела хранить (старые файлы удаляются автоматически).
VERSION_KEEP=10
# Пуши владельцу о завершении/ошибке/отмене каждого job'а (1/0).
NOTIFY_JOB_EVENTS=1
# Домены, с которых фронтенд (например GitHub Pages) может обращаться к API бота.
# Через запятую, например: https://vasya.github.io
ALLOWED_ORIGINS=
